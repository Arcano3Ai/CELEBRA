# CELEBRA — CONFIGURACIÓN DE ENTORNO

# Supabase Database & Auth
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL
VITE_APP_URL=https://celebra.app

# Pagos (Stripe & Mercado Pago)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_PHONE_NUMBER_ID=your-phone-id
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-custom-verify-token

# Almacenamiento Multimedia (Supabase Storage / Cloudflare R2)
STORAGE_BUCKET_NAME=celebra-media
STORAGE_PUBLIC_URL=https://your-project.supabase.co/storage/v1/object/public/celebra-media
